{
    "name": "timatic/php-sdk",
    "description": "PHP SDK for Timatic API built with Saloon",
    "license": "Elastic-2.0",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.39 || ^13.0",
        "nesbot/carbon": "^2.0 || ^3.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "*",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Timatic\\": "src/",
            "Timatic\\Factories\\": "Factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timatic\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timatic\\Providers\\TimaticServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "coverage": "pest --coverage --coverage-clover coverage.xml",
        "format": "pint",
        "regenerate": [
            "rm -rf src/DataTransferObjects/* src/Requests/* Factories/* tests/Requests/*",
            "php generator/generator generate:sdk openapi.json --output=. --force --exclude-put-requests",
            "@composer dump-autoload",
            "@format"
        ],
        "test": "pest"
    }
}
